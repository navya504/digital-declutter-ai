# Local inference through Ollama. Replace the fine-tuned tag with an installed model.
DECLUTTER_PROVIDER=ollama
DECLUTTER_BASE_MODEL=qwen2.5:0.5b
DECLUTTER_FINE_TUNED_MODEL=YOUR_INSTALLED_FINE_TUNED_TAG
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional Nebius Token Factory inference or fine-tuning.
# DECLUTTER_PROVIDER=nebius
# DECLUTTER_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# DECLUTTER_FINE_TUNED_MODEL=YOUR_DEPLOYED_FINE_TUNED_MODEL_ID
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_API_KEY=

# Optional Hugging Face Inference Endpoint.
# DECLUTTER_PROVIDER=huggingface
# DECLUTTER_BASE_MODEL=YOUR_ENDPOINT_BASE_MODEL
# DECLUTTER_FINE_TUNED_MODEL=YOUR_LORA_ADAPTER_ID
# HF_ENDPOINT_URL=https://YOUR-ENDPOINT.endpoints.huggingface.cloud
# HF_TOKEN=
# HF_ADAPTER_ID=YOUR_LORA_ADAPTER_ID
